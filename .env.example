# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL="postgresql://user:password@localhost:5432/mixy_shop?schema=public"

# Auth.js
AUTH_SECRET="generate-with-openssl-rand-base64-32"
AUTH_URL="http://localhost:3000"
AUTH_TRUST_HOST="true"

# Safaricom M-PESA Daraja (sandbox during development)
DARAJA_ENV=sandbox
DARAJA_CONSUMER_KEY=
DARAJA_CONSUMER_SECRET=
DARAJA_SHORTCODE=174379
DARAJA_PASSKEY=
DARAJA_CALLBACK_URL=http://localhost:3000/api/payments/mpesa/callback
# Optional: only allow callbacks from these IPs (comma separated). Leave blank during local development.
DARAJA_ALLOWED_IPS=
# Set to "true" to simulate successful STK pushes when Daraja credentials are absent (development only)
PAYMENTS_SIMULATION=false

# File storage (Cloudinary recommended in production; local private storage is used when absent)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
# Local storage directory for private uploads
UPLOAD_DIR=private/uploads

# Email notifications (optional). When absent, notifications are stored in-app and logged.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="MIX <no-reply@mix.co.ke>"
